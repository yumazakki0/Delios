rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /students/{studentId} {
      allow read: if request.auth != null && request.auth.uid == studentId;
      allow create, update, delete: if false;
    }

    match /support_reports/{reportId} {
      // O envio passa pela API para aplicar limite, triagem e separar a identidade.
      allow create: if false;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'priority',
          'review_result',
          'internal_notes',
          'updated_at'
        ])
        && request.resource.data.status in ['novo', 'em_analise', 'encaminhado', 'concluido']
        && request.resource.data.priority in ['nao_definida', 'baixa', 'media', 'alta']
        && request.resource.data.review_result in ['pendente', 'legitimo', 'conteudo_inadequado']
        && request.resource.data.internal_notes is string
        && request.resource.data.internal_notes.size() <= 3000;
      allow delete: if false;
    }

    // Convites, vínculo de identidade, auditoria e limite de envio são exclusivos da API.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
