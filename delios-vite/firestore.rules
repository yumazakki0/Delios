rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /support_reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly([
          'reporter_name',
          'school_year',
          'class_group',
          'category',
          'description',
          'status',
          'privacy_notice_acknowledged',
          'created_at',
          'updated_at'
        ])
        && (request.resource.data.reporter_name == null
          || (request.resource.data.reporter_name is string
            && request.resource.data.reporter_name.size() <= 120))
        && (request.resource.data.school_year == null
          || (request.resource.data.school_year is string
            && request.resource.data.school_year.size() <= 30))
        && (request.resource.data.class_group == null
          || (request.resource.data.class_group is string
            && request.resource.data.class_group.size() <= 30))
        && request.resource.data.category in [
          'bullying', 'cyberbullying', 'exclusao', 'ameaca', 'preconceito',
          'conflito', 'casa', 'outro', 'nao_sei'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 4000
        && request.resource.data.status == 'novo'
        && request.resource.data.privacy_notice_acknowledged == true
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'priority',
            'review_result',
            'internal_notes',
            'updated_at'
          ])
        && request.resource.data.status in [
          'novo', 'em_analise', 'encaminhado', 'concluido'
        ]
        && request.resource.data.get('priority', 'nao_definida') in [
          'nao_definida', 'baixa', 'media', 'alta'
        ]
        && request.resource.data.get('review_result', 'pendente') in [
          'pendente', 'legitimo', 'conteudo_inadequado'
        ]
        && request.resource.data.get('internal_notes', '') is string
        && request.resource.data.get('internal_notes', '').size() <= 2000
        && request.resource.data.updated_at == request.time;

      allow delete: if false;
    }
  }
}
